[worldserver]

###################################################################################################
# EventWow - configuracion del modulo
#
# Copiar a configs/modules/mod_eventwow.conf (sin .dist).
#
# IMPORTANTE: los .conf de modulos se cargan DESPUES de worldserver.conf y sus claves lo pisan
# (ConfigMgr::AddKey). Por eso las opciones del core que EventWow necesita viven aqui y no en
# worldserver.conf: este archivo es la lista completa de lo que cambiamos del core.
# worldserver.conf solo debe llevar infraestructura (BD, IPs, puertos, rutas) - ver docs/despliegue.md
###################################################################################################

###################################################################################################
# OPCIONES PROPIAS
###################################################################################################

#
#    EventWow.Enable
#        Description: Activa el modulo.
#        Default:     1

EventWow.Enable = 1

#
#    EventWow.Character.Race / EventWow.Character.Class
#        Description: Unica raza/clase con la que se puede crear personaje (IDs de ChrRaces/ChrClasses).
#                     Se aplica tambien a GMs (las mascaras del core no).
#                     Debe coincidir con EVENTWOW_CONFIG.RACE/CLASS del cliente (GlueXML/CharacterSelect.lua),
#                     con playercreateinfo (data/sql/db-world/..._lobby_playercreateinfo*.sql) y con
#                     CharacterCreating.Disabled.RaceMask/ClassMask (abajo).
#                     Druida: mana nativo y el core ya sabe cambiarle el tipo de poder (formas); base de los
#                     "disfraces" de los minijuegos. Humano druida no existe en 3.3.5.
#        Default:     4 - Night Elf / 11 - Druid

EventWow.Character.Race = 4
EventWow.Character.Class = 11

#
#    EventWow.Lobby.MapId / X / Y / Z / O
#        Description: Punto ancla del lobby ("limbo" invisible). Todo login carga aqui directamente
#                     (incluso tras desconectarse dentro de un minijuego) y se vuelve aqui al salir de uno.
#                     Debe ser un mapa NO instanciado y coincidir con playercreateinfo de la raza/clase
#                     configurada (data/sql/db-world/..._lobby_playercreateinfo.sql); el modulo avisa al
#                     arrancar si no coincide.
#        Default:     Isla de los GM - 1, 16226.2, 16257, 13.2022, 1.65007

EventWow.Lobby.MapId = 1
EventWow.Lobby.X = 16226.2
EventWow.Lobby.Y = 16257
EventWow.Lobby.Z = 13.2022
EventWow.Lobby.O = 1.65007

#
#    EventWow.Queue.FillWait
#        Description: Segundos que espera la cola de un minijuego multijugador, con MinPlayers ya
#                     reunidos, intentando llegar a MaxPlayers antes de crear la partida.
#        Default:     15

EventWow.Queue.FillWait = 15

#
#    EventWow.Queue.AcceptTimeout
#        Description: Segundos para aceptar una partida encontrada (minimo 5). Si alguien rechaza o no
#                     acepta a tiempo, se cancela: su entrada (el solo o todo su grupo) sale de la cola y
#                     los que no rechazaron vuelven a ella automaticamente, con su antiguedad.
#        Default:     20

EventWow.Queue.AcceptTimeout = 20

#
#    EventWow.Match.LoadTimeout
#        Description: Segundos para que todos los jugadores de una partida lleguen a la instancia.
#                     Los que no llegan quedan fuera y la partida empieza con el resto.
#        Default:     30

EventWow.Match.LoadTimeout = 30

#
#    EventWow.Match.ReturnDelay
#        Description: Segundos con el resultado en pantalla antes de volver al lobby.
#        Default:     8

EventWow.Match.ReturnDelay = 8

###################################################################################################
# OVERRIDES DEL CORE (pisan worldserver.conf)
###################################################################################################

#
#    CharactersPerRealm / CharactersPerAccount
#        Motivo: un solo personaje por cuenta; el cliente entra automaticamente con el.

CharactersPerRealm = 1
CharactersPerAccount = 1

#
#    HeroicCharactersPerRealm
#        Motivo: sin Caballeros de la Muerte.

HeroicCharactersPerRealm = 0

#
#    CharacterCreating.Disabled.RaceMask
#        Motivo: solo elfo de la noche. 1783 = todas las razas jugables excepto NightElf (8).
#                (1 Human + 2 Orc + 4 Dwarf + 16 Undead + 32 Tauren + 64 Gnome + 128 Troll + 512 BloodElf + 1024 Draenei)

CharacterCreating.Disabled.RaceMask = 1783

#
#    CharacterCreating.Disabled.ClassMask
#        Motivo: solo druida. 511 = todas las clases excepto Druid (1024).
#                (1 Warrior + 2 Paladin + 4 Hunter + 8 Rogue + 16 Priest + 32 DK + 64 Shaman + 128 Mage + 256 Warlock)

CharacterCreating.Disabled.ClassMask = 511

#
#    StartPlayerLevel
#        Motivo: nivel fijo del contenedor. 80 (maximo): cualquier hechizo/vehiculo de 3.3.5 funciona sin
#                penalizacion por nivel. No sube (PLAYER_FLAGS_NO_XP_GAIN); las stats las fija cada minijuego.

StartPlayerLevel = 80

#
#    AlwaysMaxSkillForLevel
#        Motivo: armas, Defensa, Desarmado... siempre al maximo del nivel (400 a nivel 80), en cada login
#                (Player::UpdateSkillsForLevel). Asi no suben jugando (sin avisos de "ha aumentado") y todos los
#                jugadores tienen el mismo indice de golpe/esquiva/parada. No toca profesiones (no hay).

AlwaysMaxSkillForLevel = 1

#
#    PlayerStart.CustomSpells
#        Motivo: el contenedor (druida) aprende en cada login (Player::LearnCustomSpells) las competencias de TODAS
#                las armas (playercreateinfo_spell_custom, SQL 2026_11_16_01): los heroes equipan arcos, espadas...
#                La tabla base de AC esta vacia: solo se aprenden las filas de EventWow.

PlayerStart.CustomSpells = 1

#
#    SkipCinematics
#        Motivo: el personaje nunca debe verse; sin cinematica de introduccion.

SkipCinematics = 2

#
#    AddonChannel
#        Motivo: el panel de minijuegos habla con el servidor por addon messages (EventWowProtocol).
#                Ya es 1 por defecto; se fija aqui para que nadie lo desactive en worldserver.conf.

AddonChannel = 1

#
#    Instance.UnloadDelay
#        Motivo: cada partida crea su propia instancia y nadie vuelve a ella; al quedar vacia se
#                descarga en 1 minuto en vez de 30 (memoria con muchas partidas).

Instance.UnloadDelay = 60000

#
#    GM.LoginState
#        Motivo: .gm on activa el "modo dev" del panel igual que .dev on (EventWowDevMode.cpp) y los dos
#                deben comportarse igual: .dev se quita en cada login, asi que el modo GM tambien empieza
#                desactivado. Se entra siempre al panel; .gm on / .dev on cuando haga falta.

GM.LoginState = 0
