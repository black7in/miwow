[worldserver]

###################################################################################################
# MiWow - configuracion del modulo
#
# Copiar a configs/modules/mod_miwow.conf (sin .dist).
#
# IMPORTANTE: los .conf de modulos se cargan DESPUES de worldserver.conf y sus claves lo pisan
# (ConfigMgr::AddKey). Por eso las opciones del core que MiWow necesita viven aqui y no en
# worldserver.conf: este archivo es la lista completa de lo que cambiamos del core.
# worldserver.conf solo debe llevar infraestructura (BD, IPs, puertos, rutas) - ver docs/despliegue.md
###################################################################################################

###################################################################################################
# OPCIONES PROPIAS
###################################################################################################

#
#    MiWow.Enable
#        Description: Activa el modulo.
#        Default:     1

MiWow.Enable = 1

#
#    MiWow.Queue.FillWait
#        Description: Segundos que espera la cola de un minijuego multijugador, con MinPlayers ya
#                     reunidos, intentando llegar a MaxPlayers antes de crear la partida.
#        Default:     15

MiWow.Queue.FillWait = 15

#
#    MiWow.Queue.AcceptTimeout
#        Description: Segundos para aceptar una partida encontrada (minimo 5). Si alguien rechaza o no
#                     acepta a tiempo, se cancela: su entrada (el solo o todo su grupo) sale de la cola y
#                     los que no rechazaron vuelven a ella automaticamente, con su antiguedad.
#        Default:     20

MiWow.Queue.AcceptTimeout = 20

#
#    MiWow.Match.LoadTimeout
#        Description: Segundos para que todos los jugadores de una partida lleguen a la instancia.
#                     Los que no llegan quedan fuera y la partida empieza con el resto.
#        Default:     30

MiWow.Match.LoadTimeout = 30

#
#    MiWow.Match.ReturnDelay
#        Description: Segundos con el resultado en pantalla antes de volver a donde estaba.
#        Default:     8

MiWow.Match.ReturnDelay = 8

###################################################################################################
# TEMPORADAS DE HERMANDAD (src/guild, definiciones en las tablas miwow_guild_* de la BD world)
###################################################################################################

#
#    MiWow.Guild.Enable
#        Description: Activa las temporadas de hermandad (tablon, puntos, ventajas, intendente).
#        Default:     1
#
MiWow.Guild.Enable = 1

#
#    MiWow.Guild.Season.Days
#        Description: Duracion de una temporada sin fila en miwow_guild_season (0 = sin fin).
#        Default:     30
#
MiWow.Guild.Season.Days = 30

#
#    MiWow.Guild.Season.Announce
#        Description: Anunciar a todo el servidor el final de la temporada y el podio.
#        Default:     1
#
MiWow.Guild.Season.Announce = 1

#
#    MiWow.Guild.DailyCap
#        Description: Puntos de temporada que puede aportar un personaje al dia (0 = sin limite).
#                     La reputacion personal no tiene limite.
#        Default:     0
#
MiWow.Guild.DailyCap = 0

#
#    MiWow.Guild.ResetRepOnLeave
#        Description: Al dejar la hermandad (o ser expulsado) la reputacion personal vuelve a 0.
#                     La contribucion de la temporada se pierde siempre.
#        Default:     1
#
MiWow.Guild.ResetRepOnLeave = 1

#
#    MiWow.Guild.Board.Daily
#    MiWow.Guild.Board.Weekly
#        Description: Misiones del tablon (al azar entre las de miwow_guild_quest). Rotan con el
#                     reinicio de misiones diarias / semanales del servidor.
#        Default:     5, 2
#
MiWow.Guild.Board.Daily = 5
MiWow.Guild.Board.Weekly = 2

#
#    MiWow.Guild.BoardObject
#    MiWow.Guild.VendorCreature
#        Description: Objeto del tablon (da y recoge las misiones de hermandad; el modulo le pone en memoria
#                     las del tablon) y PNJ intendente (abre la tienda de la hermandad; para comprar hay que
#                     estar a menos de 10 m de el).
#        Default:     9500200 (objeto), 9500201 (PNJ)
#
MiWow.Guild.BoardObject = 9500200
MiWow.Guild.VendorCreature = 9500201

#
#    MiWow.Guild.Vendor.ItemCount
#        Description: Objetos de la tienda por temporada (al azar entre los de miwow_guild_vendor).
#        Default:     10
#
MiWow.Guild.Vendor.ItemCount = 10

###################################################################################################
# OVERRIDES DEL CORE (pisan worldserver.conf)
###################################################################################################

#
#    AddonChannel
#        Motivo: el panel de minijuegos habla con el servidor por addon messages (MiWowProtocol).
#                Ya es 1 por defecto; se fija aqui para que nadie lo desactive en worldserver.conf.

AddonChannel = 1

#
#    GM.LoginState
#        Motivo: .gm on activa el "modo dev" de MiWow igual que .dev on (MiWowDevMode.cpp) y los dos
#                deben comportarse igual: .dev se quita en cada login, asi que el modo GM tambien empieza
#                desactivado. .gm on / .dev on cuando haga falta.

GM.LoginState = 0
