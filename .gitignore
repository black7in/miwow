# Core: repositorio propio (fork de AzerothCore, rama eventwow)
/azerothcore-wotlk/

# Build de CMake / Visual Studio (binarios, configs, logs locales)
/server/

# Interfaz original de Blizzard: se regenera con tools/Merge-Interface.ps1
/client/interface-original/

# DBC originales del cliente (Blizzard): base de tools/Build-Dbc.ps1. DBCesES = cliente esES, DBCenEN = ingles
/client/DBCs/

# Salida generada por tools/Build-Patch.ps1
/client/patches/

# Configuracion local con datos de entorno (credenciales, IPs)
*.conf
!*.conf.dist

# Varios
Thumbs.db
desktop.ini
*.tmp
*.log
